class BTNode {
    // constructor initializes the node with the given order 
    constructor(order){
        //Maximum No of keys it can have following the B tree property 
        this.full = order - 1;
        // Reference to the parent node 
        this.father = null;
        // array to hod the child nodes 
        this.children = [];
        //Array to hold the keys 
        this. keys =[];
    }

    // To check if this node is the last  internal node in the tree because 
    //insertion only happens on the leaf nodes of the b trees .
    isLastInternalNode() {
        // If the node has no keys ,it cannot be the least internal nodes 
        if (this.keys.length === 0 ){
            return false ;
        }
        // check if all child node are leaf node (i.e. ,have no keys )
        for (let child of this.children){
            if(child && child.keys.length !==0 ){
            return false ;
            }
            
        }
    }

}